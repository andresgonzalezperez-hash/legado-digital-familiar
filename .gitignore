# =========================================================================
#             GITIGNORE - LEGADO DIGITAL FAMILIAR
# =========================================================================

# Bases de datos, backups personales y llaves de cifrado
*.kdbx
*.pcv
*.key
*.cryptomator
*.bkup
*.c9r
BACKUPS_CIFRADOS/*.json

# Bóveda Documental (carpetas con PDFs reales de escrituras, seguros, etc.)
**/BOVEDA_DOCUMENTAL/
**/BOVEDA_DOCUMENTAL/**/*

# Datos privados del usuario
**/DATA/inventario.json
**/DATA/checklist.json
**/DATA/perfiles.json
**/DATA/config.local.json

# Archivos del sistema operativo y basura
Thumbs.db
Desktop.ini
.DS_Store
.directory

# Carpetas de caché, artefactos intermedios de Archify y tareas del sistema
.system_generated/
.archify/
*.finalize*.json
*.browser-check.json
*.receipt.json
scratch/
*.log
.tmp.*
.env
.env.*
!.env.example

# Android build artifacts y caches
TOOLS/android-app/.gradle/
TOOLS/android-app/build/
TOOLS/android-app/app/build/
TOOLS/android-app/app/src/main/assets/
*.apk
